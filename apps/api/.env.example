# Copy to .env and fill in what you need. Never commit .env (it is git-ignored).
# Everything is optional: with no .env the API runs offline with stand-in models.

# Frontend origins allowed to call the API, comma-separated.
CORS_ORIGINS=http://localhost:3000

# ---------- Models ----------
# "fake" runs offline with no key. "gemini" uses Google's free tier.
LLM_PROVIDER=fake
# Free key, no credit card: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# minimal | low | medium | high. Leave empty if the model rejects it.
GEMINI_THINKING_LEVEL=low

# ---------- Database ----------
# Postgres with pgvector, e.g. Supabase (free plan). Empty = keep everything in memory.
# Supabase: Project → Connect → "Session pooler" connection string.
DATABASE_URL=

# ---------- Limits and tuning ----------
MAX_UPLOAD_BYTES=20971520
MAX_PAGES=300
# Chunking, in characters
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
# How many chunks to use, and the minimum relevance score (0 to 1).
# Leave MIN_SCORE empty for the provider's default (fake 0.08, gemini 0.55).
TOP_K=4
MIN_SCORE=

# ---------- Request limits (public demo) ----------
# 0 turns a limit off. Gemini's free tier allows 15 model calls a minute for the
# whole app and a question takes up to 3, hence 5 questions a minute app-wide.
CHAT_PER_CLIENT_PER_MINUTE=4
CHAT_PER_CLIENT_PER_DAY=50
CHAT_PER_MINUTE=5
UPLOADS_PER_CLIENT_PER_HOUR=10
