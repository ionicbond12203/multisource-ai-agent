# Copy to .env and change what you need. Every value below is the default.

# Frontend origins allowed to call the API, comma-separated.
CORS_ORIGINS=http://localhost:3000

# Model provider. "fake" runs offline with no API key.
LLM_PROVIDER=fake

# Upload limits
MAX_UPLOAD_BYTES=20971520
MAX_PAGES=300

# Chunking, in characters
CHUNK_SIZE=1200
CHUNK_OVERLAP=200

# Retrieval: how many chunks to use, and the minimum relevance score (0 to 1)
TOP_K=4
MIN_SCORE=0.08
